name: Supply Order
type: Orders/Order with Clauses
timelineReadAccess:
  type: Dictionary
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        buyer:
          type: Parties/Party
        supplier:
          type: Parties/Party
      required: []
  payment:
    type: Payment/Payment Clause
    parameters:
      obtain: create
      fieldPaths:
        readerAccess: /timelineReadAccess
      template:
        name: Manual payment for the Order
        type: ManualPayments/Manual Receipt Instruction
        timelineReadAccess:
          type: Dictionary
        clauses:
          activation:
            type: Activation/Activation Clause
            parameters:
              parties:
                payer:
                  type: Parties/Party
                payee:
                  type: Parties/Party
                guarantor:
                  type: Parties/Party
              required: []
        paymentTerms:
          amountMinor: 200
          limitMinor: 200
          currency: EUR
          payerChannel: payer
          payeeChannel: payee
          guarantorChannel: guarantor
          allowedPayees:
            - payee
          recipientApprovalRequired: false
    bindings:
      instruction: /payment
      parties:
        payer: buyer
        payee: supplier
        guarantor: supplier
      prepare:
        preparePayment:
          on: workflow
          party: buyer
          params:
            values:
              readerAccess:
                $document: /timelineReadAccess
  receiptReaction:
    type:
      name: Order Receipt Reaction Clause
      type: clause-connections/Connected Clause
      actions:
        record:
          do:
            - $failIf:
                cond:
                  $ne:
                    - $var:
                        name: trigger
                        path: /amountMinor
                    - $document: /payment/paymentTerms/amountMinor
                message: Receipt amount differs from payment terms
            - $failIf:
                cond:
                  $ne:
                    - $document: /payment/payment/completed
                    - $var:
                        name: trigger
                        path: /amountMinor
                message: Payment is not completed for this amount
            - $failIf:
                cond:
                  $ne:
                    - $document: /payment/paymentTerms/currency
                    - $document: /currency
                message: Payment currency differs from order
            - $if:
                cond:
                  $eq:
                    - $document: /lastPaymentRequestId
                    - $var:
                        name: trigger
                        path: /requestId
                then:
                  - $return: {}
            - $failIf:
                cond:
                  $ne:
                    - $document: /paidTotal
                    - 0
                message: Order already credited by another receipt
            - $appendChange:
                op: replace
                path: /paidTotal
                val:
                  $var:
                    name: trigger
                    path: /amountMinor
            - $appendChange:
                op: replace
                path: /paymentStatus
                val: paid
            - $appendChange:
                op: replace
                path: /lastPaymentRequestId
                val:
                  $var:
                    name: trigger
                    path: /requestId
            - $appendEvent:
                kind: Order Payment Recorded
                orderId:
                  $document: /orderId
                requestId:
                  $var:
                    name: trigger
                    path: /requestId
                amountMinor:
                  $var:
                    name: trigger
                    path: /amountMinor
                currency:
                  $document: /currency
    bindings:
      record:
        received:
          on: embedded
          path: /payment
          embed: false
          event:
            type: PaymentInstruction/Payment Event
            kind: Manual Receipt Acknowledged
orderId:
  type: Text
paidTotal: 0
paymentStatus: unpaid
lastPaymentRequestId: ""
currency: EUR
