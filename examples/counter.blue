name: Hello Counter
count: 0
initialized: false
contracts:
  input: {type: Contracts/External Channel}
  lifecycle: {type: Contracts/Lifecycle Event Channel}
  started:
    type: Contracts/Sequential Workflow
    channel: lifecycle
    steps:
      - type: Contracts/Update Document
        changeset: [{op: replace, path: /initialized, val: true}]
      - type: Contracts/Trigger Event
        event: {kind: Counter Initialized}
  increment:
    type: Contracts/Sequential Workflow Operation
    channel: input
    steps:
      - type: Contracts/Update Document
        changeset:
          - op: replace
            path: /count
            val: {$add: [{$document: /count}, 1]}
      - type: Contracts/Trigger Event
        event: {kind: Count Changed, count: {$document: /count}}
