key: o1
paidTotal: 0
payments:
  p0:
    key: o1-p0
    paid: false
    recordedAmount: 0
    name: Payment
    contracts:
      settle:
        type: Contracts/Sequential Workflow Operation
        steps:
        - type: Contracts/Compute
          do:
          - $failIf:
              cond:
                $document: /paid
              message: Already settled
          - $appendChange:
              op: replace
              path: /paid
              val: true
        - type: Contracts/Trigger Event
          event:
            kind: Payment Settled
            amount:
              $document: /amount
        channel: input
      input:
        type: Contracts/External Channel
      record:
        type: Contracts/Sequential Workflow Operation
        steps:
        - type: Contracts/Update Document
          changeset:
          - op: replace
            path: /recordedAmount
            val:
              $add:
              - $document: /recordedAmount
              - $document: /amount
        - type: Contracts/Trigger Event
          event:
            kind: Payment Settled
            amount:
              $document: /amount
        channel: input
    amount: 42
  p1:
    key: o1-p1
    paid: false
    recordedAmount: 0
    name: Payment
    contracts:
      settle:
        type: Contracts/Sequential Workflow Operation
        steps:
        - type: Contracts/Compute
          do:
          - $failIf:
              cond:
                $document: /paid
              message: Already settled
          - $appendChange:
              op: replace
              path: /paid
              val: true
        - type: Contracts/Trigger Event
          event:
            kind: Payment Settled
            amount:
              $document: /amount
        channel: input
      input:
        type: Contracts/External Channel
      record:
        type: Contracts/Sequential Workflow Operation
        steps:
        - type: Contracts/Update Document
          changeset:
          - op: replace
            path: /recordedAmount
            val:
              $add:
              - $document: /recordedAmount
              - $document: /amount
        - type: Contracts/Trigger Event
          event:
            kind: Payment Settled
            amount:
              $document: /amount
        channel: input
    amount: 42
contracts:
  embedded:
    collectionPaths:
    - /payments
    type: Contracts/Process Embedded
  init:
    type: Contracts/Lifecycle Event Channel
  input:
    type: Contracts/External Channel
  paid:
    type: Contracts/Embedded Node Channel
    event:
      kind: Payment Settled
  paymentPaid:
    type: Contracts/Sequential Workflow
    steps:
    - type: Contracts/Update Document
      changeset:
      - op: replace
        path: /paidTotal
        val:
          $add:
          - $document: /paidTotal
          - $event: /event/amount
    - type: Contracts/Trigger Event
      event:
        kind: Order Paid
        amount:
          $event: /event/amount
        key: o1
    channel: paid
  started:
    type: Contracts/Sequential Workflow
    steps:
    - type: Contracts/Trigger Event
      event:
        kind: Order Initialized
        key: o1
    channel: init
name: Order
