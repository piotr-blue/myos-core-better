{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Authenticated MyOS Better console; private EC2 origin and isolated Cognito identities.",
  "Resources": {
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": "myos-better-console-20261105",
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "UserPoolTags": {
          "owner": "myos-core-better",
          "environment": "isolated-experiment",
          "review-after": "2026-11-12"
        }
      }
    },
    "UserClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "GenerateSecret": false,
        "ExplicitAuthFlows": [
          "ALLOW_USER_PASSWORD_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 1,
        "IdTokenValidity": 1,
        "RefreshTokenValidity": 1
      }
    },
    "ConsoleIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": "sg-06469f6e74f6cc0f9",
        "IpProtocol": "tcp",
        "FromPort": 8088,
        "ToPort": 8088,
        "SourcePrefixListId": "pl-4fa04526",
        "Description": "MyOS Better console via CloudFront only"
      }
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "DependsOn": "ConsoleIngress",
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Name": "myos-better-console-20261105",
          "Arn": "arn:aws:ec2:eu-west-1:581571886327:instance/i-0d892c8d2e30807a2",
          "HTTPPort": 8088,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSSLProtocols": [
            "TLSv1.2"
          ]
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "MyOS Better console \u2014 isolated experiment",
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "Better",
              "DomainName": "ip-172-31-26-71.eu-west-1.compute.internal",
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "Better",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
            "Compress": true
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ]
        },
        "Tags": [
          {
            "Key": "owner",
            "Value": "myos-core-better"
          },
          {
            "Key": "environment",
            "Value": "isolated-experiment"
          },
          {
            "Key": "review-after",
            "Value": "2026-11-12"
          }
        ]
      }
    }
  },
  "Outputs": {
    "UserPool": {
      "Value": {
        "Ref": "UserPool"
      }
    },
    "UserClient": {
      "Value": {
        "Ref": "UserClient"
      }
    },
    "Distribution": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    }
  }
}
