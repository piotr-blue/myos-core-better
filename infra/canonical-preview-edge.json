{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Canonical preview HTTPS edge; existing sign-in identities, isolated application storage.",
  "Resources": {
    "ConsoleIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": "sg-0a17615dd6dcce8f2",
        "IpProtocol": "tcp",
        "FromPort": 8088,
        "ToPort": 8088,
        "SourcePrefixListId": "pl-4fa04526",
        "Description": "MyOS Better console via CloudFront only"
      }
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "DependsOn": "ConsoleIngress",
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Name": "myos-better-canonical-console-20261108",
          "Arn": "arn:aws:ec2:eu-west-1:581571886327:instance/i-052007ebaf704c0ad",
          "HTTPPort": 8088,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSSLProtocols": [
            "TLSv1.2"
          ]
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "MyOS canonical preview \u2014 isolated application storage",
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "Better",
              "DomainName": "ip-172-31-18-53.eu-west-1.compute.internal",
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "Better",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
            "Compress": true
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ]
        },
        "Tags": [
          {
            "Key": "owner",
            "Value": "myos-core-better"
          },
          {
            "Key": "environment",
            "Value": "isolated-experiment"
          },
          {
            "Key": "review-after",
            "Value": "2026-11-12"
          }
        ]
      }
    }
  },
  "Outputs": {
    "UserPool": {
      "Value": "eu-west-1_sWm7zJJEO"
    },
    "UserClient": {
      "Value": "4qja6n3otf2nkt753ai44lgkep"
    },
    "Distribution": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    }
  }
}
