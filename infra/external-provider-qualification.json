{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated external canonical Timeline provider for MyOS owner qualification",
  "Resources": {
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "DependsOn": "ExternalIngressGroup",
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Name": {
            "Ref": "AWS::StackName"
          },
          "Arn": {
            "Ref": "InstanceArn"
          },
          "HTTPPort": 8089,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSSLProtocols": [
            "TLSv1.2"
          ]
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "External native Timeline qualification",
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "Better",
              "DomainName": {
                "Ref": "PrivateDns"
              },
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "VpcOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "Better",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "POST",
              "PATCH",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
            "Compress": true
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 400,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 405,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ]
        },
        "Tags": [
          {
            "Key": "environment",
            "Value": "isolated-experiment"
          }
        ]
      }
    },
    "ExternalIngressGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Separate canonical external provider through CloudFront only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8089,
            "ToPort": 8089,
            "SourcePrefixListId": {
              "Ref": "CloudFrontPrefixList"
            }
          }
        ],
        "Tags": [
          {
            "Key": "owner",
            "Value": "myos-core-better"
          }
        ]
      }
    }
  },
  "Outputs": {
    "Distribution": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "SecurityGroup": {
      "Value": {
        "Ref": "ExternalIngressGroup"
      }
    }
  },
  "Parameters": {
    "VpcId": {
      "Type": "String"
    },
    "InstanceArn": {
      "Type": "String"
    },
    "PrivateDns": {
      "Type": "String"
    },
    "CloudFrontPrefixList": {
      "Type": "String"
    }
  }
}
